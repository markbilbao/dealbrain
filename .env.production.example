# Production-shaped configuration (Sprint 22 + Sprint 23 persistence)
# EXAMPLE ONLY — do not put real secrets here.

APP_NAME=DealBrain
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Replace with vault-injected DSN in a real deployment.
DATABASE_URL=postgresql+asyncpg://dealbrain:CHANGE_ME@db:5432/dealbrain
DATABASE_ECHO=false

# Durable backends required for production operational state (Sprint 23).
PERSISTENCE_BACKEND=sqlalchemy
USER_PLATFORM_BACKEND=sqlalchemy
MARKETPLACE_DATA_BACKEND=sqlalchemy
ALERTS_BACKEND=sqlalchemy
NOTIFICATIONS_BACKEND=sqlalchemy
AFFILIATE_BACKEND=sqlalchemy
MERCHANT_BACKEND=sqlalchemy
ALLOW_DEMO_RESET_TOKENS=false
SEED_DEMO_DATA=false

CANONICAL_REGISTRY_BACKEND=sqlalchemy
PRICE_HISTORY_BACKEND=sqlalchemy
PRICE_TREND_THRESHOLD_PERCENT=2.0
PRICE_HISTORY_SEED_DEMO_MOCK=false

CORS_ORIGINS=https://app.dealbrain.example

AI_REVIEW_ENABLED=false
AI_REVIEW_LIVE_HTTP=false
AI_SHOPPING_ENABLED=false
AI_SHOPPING_LIVE_HTTP=false
AI_COMMUNITY_ENABLED=false
AI_COMMUNITY_LIVE_HTTP=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

USER_PLATFORM_ENABLED=true
MARKETPLACE_DATA_ENABLED=true
MARKETPLACE_DATA_REQUIRE_AUTH=true
WATCHLISTS_ALERTS_ENABLED=true
WATCHLISTS_REQUIRE_AUTH=true
AFFILIATE_ENABLED=true
MERCHANT_PLATFORM_ENABLED=true
MERCHANT_PLATFORM_REQUIRE_AUTH=true

LAUNCH_READINESS_ENABLED=true
LAUNCH_STRICT_STARTUP=true
RATE_LIMITING_ENABLED=true
SECURITY_HEADERS_ENABLED=true
STRUCTURED_LOGGING_ENABLED=true
DEMO_LAUNCHER_ENABLED=false
PERFORMANCE_CACHE_ENABLED=true
PERFORMANCE_CACHE_TTL_SECONDS=20
OPENAPI_PUBLIC_DOCS=false

RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTRATION_PER_MINUTE=3
RATE_LIMIT_AFFILIATE_PER_MINUTE=30
RATE_LIMIT_MERCHANT_PER_MINUTE=30
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_RECOMMENDATIONS_PER_MINUTE=30

SECURITY_HSTS_MAX_AGE=31536000
SECURITY_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=(), payment=()
