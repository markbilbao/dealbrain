{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dealbrain.local/schemas/release-manifest.schema.json",
  "title": "DealBrain Release Manifest",
  "description": "Sprint 25b.1 machine-readable release evidence. Digest is deployment authority; mutable tags are never authoritative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "git_sha",
    "image_repository",
    "image_digest",
    "image_tag_sha",
    "build_workflow_run_id",
    "test_workflow_run_id",
    "staging_deployment_run_id",
    "staging_timestamp",
    "staging_verification",
    "production_approval_identity",
    "production_deployment_run_id",
    "migration_revision_before",
    "migration_revision_after",
    "rollback_digest",
    "environment",
    "final_status",
    "created_at",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "release_id": {
      "type": "string",
      "pattern": "^rel-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{7,40}$"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "image_repository": {
      "type": "string",
      "description": "Canonical GHCR repository without tag or digest suffix.",
      "pattern": "^ghcr\\.io/[a-z0-9]([a-z0-9._-]*/)+[a-z0-9._-]+$"
    },
    "image_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "image_tag_sha": {
      "type": "string",
      "pattern": "^sha-[0-9a-f]{40}$"
    },
    "build_workflow_run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+$"
    },
    "test_workflow_run_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]+$"
    },
    "staging_deployment_run_id": {
      "type": ["string", "null"]
    },
    "staging_timestamp": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "staging_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["live", "ready", "alb", "smoke", "result"],
      "properties": {
        "live": { "type": ["boolean", "null"] },
        "ready": { "type": ["boolean", "null"] },
        "alb": { "type": ["boolean", "null"] },
        "smoke": { "type": ["boolean", "null"] },
        "result": {
          "type": "string",
          "enum": ["pending", "passed", "failed", "skipped"]
        }
      }
    },
    "production_approval_identity": {
      "type": ["string", "null"]
    },
    "production_deployment_run_id": {
      "type": ["string", "null"]
    },
    "migration_revision_before": {
      "type": ["string", "null"]
    },
    "migration_revision_after": {
      "type": ["string", "null"]
    },
    "rollback_digest": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "environment": {
      "type": "string",
      "enum": ["none", "staging", "production"]
    },
    "final_status": {
      "type": "string",
      "enum": [
        "built",
        "staging_ok",
        "approved",
        "production_ok",
        "failed",
        "rolled_back"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
