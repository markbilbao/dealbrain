{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.piqsavi.com/sprint29/decision-context-v1.2.schema.json",
  "title": "PiqSavi Sprint 29 decision context v1.2 with presentation contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_classification",
    "decision_id",
    "context_version",
    "owner",
    "evaluated_products",
    "recommendation",
    "evidence",
    "unknowns",
    "affiliate_neutrality",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": { "const": "1.2" },
    "data_classification": {
      "enum": ["non_live_contract_fixture", "canonical_decision"]
    },
    "decision_id": { "type": "string", "format": "uuid" },
    "context_version": { "type": "integer", "minimum": 1 },
    "owner": { "$ref": "#/$defs/owner" },
    "evaluated_products": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/evaluatedProduct" }
    },
    "recommendation": { "$ref": "#/$defs/recommendation" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "affiliate_neutrality": { "$ref": "#/$defs/affiliateNeutrality" },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "offer_economics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/offerEconomics" }
    },
    "delivery_context": { "$ref": "#/$defs/deliveryContext" },
    "qualification": { "$ref": "#/$defs/qualification" },
    "shopper_context": { "$ref": "#/$defs/shopperContext" },
    "product_presentation": {
      "type": "array",
      "items": { "$ref": "#/$defs/productPresentation" }
    },
    "recommendation_reasons": {
      "type": "array",
      "items": { "$ref": "#/$defs/recommendationReason" }
    },
    "best_for": {
      "type": "array",
      "items": { "$ref": "#/$defs/bestFor" }
    },
    "alternative_tradeoffs": {
      "type": "array",
      "items": { "$ref": "#/$defs/alternativeTradeoff" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_type", "principal_id", "session_id", "expires_at"],
      "properties": {
        "principal_type": { "enum": ["guest", "account"] },
        "principal_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "session_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "canonicalPiqScore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "authority", "semantics_version", "snapshot_sha256"],
      "properties": {
        "value": { "type": "number", "minimum": 0, "maximum": 100 },
        "authority": { "const": "canonical-piqscore-dealscore-engine" },
        "semantics_version": { "type": "string", "minLength": 1 },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evaluatedProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "display_name", "variant", "canonical_piqscore"],
      "properties": {
        "product_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "variant": { "type": "string", "minLength": 1, "maxLength": 200 },
        "canonical_piqscore": { "$ref": "#/$defs/canonicalPiqScore" }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "decision",
        "best_piq_product_id",
        "alternative_product_ids",
        "snapshot_sha256"
      ],
      "properties": {
        "authority": { "const": "canonical-recommendation-engine" },
        "decision": { "enum": ["buy", "wait", "consider", "avoid"] },
        "best_piq_product_id": { "type": "string", "minLength": 1 },
        "alternative_product_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "snapshot_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "product_id",
        "topic",
        "fact",
        "source",
        "captured_at",
        "freshness",
        "provenance_sha256"
      ],
      "properties": {
        "evidence_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "product_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "topic": { "type": "string", "minLength": 1, "maxLength": 128 },
        "fact": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "source": { "type": "string", "minLength": 1, "maxLength": 256 },
        "captured_at": { "type": "string", "format": "date-time" },
        "freshness": { "enum": ["fresh", "stale", "unknown"] },
        "provenance_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "affiliateNeutrality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commission_influenced_candidates",
        "commission_influenced_scores",
        "commission_influenced_recommendation",
        "commission_influenced_ordering"
      ],
      "properties": {
        "commission_influenced_candidates": { "const": false },
        "commission_influenced_scores": { "const": false },
        "commission_influenced_recommendation": { "const": false },
        "commission_influenced_ordering": { "const": false }
      }
    },
    "moneyLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "amount_minor", "currency", "status", "applied"],
      "properties": {
        "kind": {
          "enum": ["listing", "discount", "voucher", "shipping", "tax", "import"]
        },
        "amount_minor": { "type": ["integer", "null"] },
        "currency": { "type": "string", "minLength": 1, "maxLength": 8 },
        "status": {
          "enum": [
            "verified",
            "estimated",
            "unknown",
            "not_applicable",
            "expired",
            "unsupported",
            "unverified"
          ]
        },
        "applied": { "type": "boolean" },
        "evidence_id": { "type": ["string", "null"], "maxLength": 128 },
        "label": { "type": ["string", "null"], "maxLength": 128 }
      }
    },
    "deliveryContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "city": { "type": ["string", "null"], "maxLength": 80 },
        "postal_code": { "type": ["string", "null"], "maxLength": 12 },
        "country": { "type": ["string", "null"], "maxLength": 64 }
      }
    },
    "offerEconomics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offer_id",
        "product_id",
        "currency",
        "listing",
        "shipping",
        "taxes",
        "price_state",
        "dominant_amount_minor",
        "international",
        "unknowns",
        "evidence_ids"
      ],
      "properties": {
        "offer_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "product_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "currency": { "type": "string", "minLength": 1, "maxLength": 8 },
        "listing": { "$ref": "#/$defs/moneyLine" },
        "shipping": { "$ref": "#/$defs/moneyLine" },
        "taxes": { "$ref": "#/$defs/moneyLine" },
        "price_state": {
          "enum": [
            "final_effective_cost",
            "estimated_landed_cost",
            "price_before_shipping",
            "before_unverified_import_charges",
            "potential_checkout_price"
          ]
        },
        "dominant_amount_minor": { "type": ["integer", "null"] },
        "merchant": { "type": ["string", "null"], "maxLength": 128 },
        "marketplace": { "type": ["string", "null"], "maxLength": 128 },
        "seller_id": { "type": ["string", "null"], "maxLength": 128 },
        "voucher": { "oneOf": [{ "$ref": "#/$defs/moneyLine" }, { "type": "null" }] },
        "import_charges": { "oneOf": [{ "$ref": "#/$defs/moneyLine" }, { "type": "null" }] },
        "delivery": { "oneOf": [{ "$ref": "#/$defs/deliveryContext" }, { "type": "null" }] },
        "international": { "type": "boolean" },
        "unknowns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "evidence_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "provenance_source": { "type": ["string", "null"], "maxLength": 256 },
        "checked_at": { "type": ["string", "null"], "format": "date-time" },
        "freshness": {
          "type": ["string", "null"],
          "enum": ["fresh", "stale", "unknown", null]
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasons", "material_unknowns", "could_change_recommendation"],
      "properties": {
        "state": { "enum": ["unqualified", "qualified"] },
        "reasons": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "material_unknowns": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "could_change_recommendation": { "type": "boolean" }
      }
    },
    "shopperContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget_label": { "type": ["string", "null"], "maxLength": 80 },
        "top_priority": { "type": ["string", "null"], "maxLength": 80 },
        "priorities": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "use_case": { "type": ["string", "null"], "maxLength": 160 },
        "urgency": { "type": ["string", "null"], "maxLength": 80 },
        "required_features": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "preferences": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 160 } },
        "constraints": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 160 } }
      }
    },
    "fitAttribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "value", "status", "evidence_ids"],
      "properties": {
        "key": { "type": "string", "minLength": 1, "maxLength": 64 },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "value": { "type": "string", "minLength": 1, "maxLength": 160 },
        "unit": { "type": ["string", "null"], "maxLength": 24 },
        "status": { "enum": ["known", "estimated", "unknown"] },
        "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "productPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "fit_attributes"],
      "properties": {
        "product_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "brand": { "type": ["string", "null"], "maxLength": 80 },
        "model": { "type": ["string", "null"], "maxLength": 160 },
        "category": { "type": ["string", "null"], "maxLength": 80 },
        "offer_url": { "type": ["string", "null"], "maxLength": 2048 },
        "fit_attributes": { "type": "array", "items": { "$ref": "#/$defs/fitAttribute" } }
      }
    },
    "recommendationReason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "evidence_ids"],
      "properties": {
        "reason": { "type": "string", "minLength": 1, "maxLength": 400 },
        "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "shopper_priority": { "type": ["string", "null"], "maxLength": 80 },
        "product_id": { "type": ["string", "null"] },
        "related_attribute": { "type": ["string", "null"], "maxLength": 80 }
      }
    },
    "bestFor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "evidence_ids"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "alternativeTradeoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_id", "reason", "evidence_ids"],
      "properties": {
        "product_id": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 400 },
        "evidence_ids": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
