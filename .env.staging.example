# Staging / public beta rehearsal (Sprint 22)
# Copy to .env.staging — contains NO production secrets.

APP_NAME=PiqSavi
APP_ENV=staging
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://dealbrain:dealbrain@db:5432/dealbrain
DATABASE_ECHO=false

# Staging secret material (never production values).
APP_SECRET_KEY=staging-only-not-for-production-use-32c
TRUSTED_HOSTS=staging.dealbrain.example

# Prefer durable operational persistence for staging rehearsals (Sprint 23).
PERSISTENCE_BACKEND=sqlalchemy
# Runtime Sprint 27 policy already forbids inline identity tokens outside
# development. Staging example must match that truth.
ALLOW_DEMO_RESET_TOKENS=false
SEED_DEMO_DATA=true

# Identity transactional email cutover contract (Sprint 27.3).
# Non-secret only. Do not put RESEND_API_KEY here — inject from AWS Secrets
# Manager leaf dealbrain/staging/resend_api_key via assemble-runtime-env.py.
# An empty or placeholder key must not be committed and must not pass validation.
TRANSACTIONAL_EMAIL_PROVIDER=resend
TRANSACTIONAL_EMAIL_FROM=no-reply@piqsavi.com
TRANSACTIONAL_EMAIL_FROM_NAME=PiqSavi
# Approved staging PiqSavi action-link host. This is the trusted configured
# origin, not proof that DNS or TLS currently resolve.
PUBLIC_APP_BASE_URL=https://staging.piqsavi.com

CANONICAL_REGISTRY_BACKEND=sqlalchemy
PRICE_HISTORY_BACKEND=sqlalchemy
PRICE_TREND_THRESHOLD_PERCENT=2.0
PRICE_HISTORY_SEED_DEMO_MOCK=false

CORS_ORIGINS=https://staging.dealbrain.example,http://localhost:8000

AI_REVIEW_ENABLED=false
AI_REVIEW_LIVE_HTTP=false
AI_SHOPPING_ENABLED=false
AI_SHOPPING_LIVE_HTTP=false
AI_COMMUNITY_ENABLED=false
AI_COMMUNITY_LIVE_HTTP=false

USER_PLATFORM_ENABLED=true
MARKETPLACE_DATA_ENABLED=true
MARKETPLACE_DATA_REQUIRE_AUTH=true
WATCHLISTS_ALERTS_ENABLED=true
WATCHLISTS_REQUIRE_AUTH=true
AFFILIATE_ENABLED=true
MERCHANT_PLATFORM_ENABLED=true
MERCHANT_PLATFORM_REQUIRE_AUTH=true

LAUNCH_READINESS_ENABLED=true
LAUNCH_STRICT_STARTUP=false
RATE_LIMITING_ENABLED=true
SECURITY_HEADERS_ENABLED=true
STRUCTURED_LOGGING_ENABLED=true
DEMO_LAUNCHER_ENABLED=true
PERFORMANCE_CACHE_ENABLED=true
PERFORMANCE_CACHE_TTL_SECONDS=30
OPENAPI_PUBLIC_DOCS=false

RATE_LIMIT_DEFAULT_PER_MINUTE=90
RATE_LIMIT_LOGIN_PER_MINUTE=8
RATE_LIMIT_REGISTRATION_PER_MINUTE=4
RATE_LIMIT_AFFILIATE_PER_MINUTE=45
RATE_LIMIT_MERCHANT_PER_MINUTE=45
RATE_LIMIT_SEARCH_PER_MINUTE=45
RATE_LIMIT_RECOMMENDATIONS_PER_MINUTE=45

SECURITY_HSTS_MAX_AGE=31536000
SECURITY_FRAME_OPTIONS=DENY
