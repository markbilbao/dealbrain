# Application
APP_NAME=DealBrain
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://dealbrain:dealbrain@localhost:5432/dealbrain
DATABASE_ECHO=false

# Canonical registry: memory (demo) or sqlalchemy (Postgres)
CANONICAL_REGISTRY_BACKEND=memory

# Price history: memory (demo) or sqlalchemy (Postgres)
PRICE_HISTORY_BACKEND=memory
PRICE_TREND_THRESHOLD_PERCENT=2.0
# Seed development-only iPhone mock history on /price-history/search (ignored in production)
PRICE_HISTORY_SEED_DEMO_MOCK=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------------------------------------------------------------------------
# AI Review Summary — multi-model providers (DISABLED by default)
# ---------------------------------------------------------------------------
# Adding API keys alone does NOT enable expensive modes or live HTTP.
# AI_REVIEW_ENABLED must be true AND AI_REVIEW_LIVE_HTTP must be true for
# real provider calls. Keep keys server-side only — never expose to clients.
AI_REVIEW_ENABLED=false
AI_REVIEW_MODE=economy
AI_REVIEW_ALLOW_CLIENT_MODE=true
AI_PRIMARY_PROVIDER=openai
AI_SECONDARY_PROVIDER=anthropic
AI_FALLBACK_ORDER=openai,anthropic,gemini,deterministic
AI_REVIEW_LIVE_HTTP=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

AI_PROVIDER_TIMEOUT_SECONDS=20
AI_MAX_REVIEW_INPUT=40
AI_MAX_ESTIMATED_COST_PER_REQUEST=0.05

# ---------------------------------------------------------------------------
# AI Shopping Assistant (DISABLED by default)
# ---------------------------------------------------------------------------
AI_SHOPPING_ENABLED=false
AI_SHOPPING_MODE=economy
AI_SHOPPING_ALLOW_CLIENT_MODE=true
AI_SHOPPING_MAX_QUERY_LENGTH=500
AI_SHOPPING_CONVERSATION_TTL_SECONDS=1800
AI_SHOPPING_LIVE_HTTP=false

# ---------------------------------------------------------------------------
# Community Intelligence Platform
# ---------------------------------------------------------------------------
COMMUNITY_ENABLED=true
COMMUNITY_REDDIT_ENABLED=true
COMMUNITY_YOUTUBE_ENABLED=false
COMMUNITY_AMAZON_QA_ENABLED=false
COMMUNITY_MARKETPLACE_QA_ENABLED=false
COMMUNITY_FORUMS_ENABLED=false
COMMUNITY_DISCORD_ENABLED=false
COMMUNITY_USE_FIXTURES=true
AI_COMMUNITY_ENABLED=false
AI_COMMUNITY_MODE=economy
AI_COMMUNITY_ALLOW_CLIENT_MODE=true
AI_COMMUNITY_LIVE_HTTP=false

# ---------------------------------------------------------------------------
# Knowledge Graph (in-memory; no external graph database)
# ---------------------------------------------------------------------------
KNOWLEDGE_GRAPH_ENABLED=true
KNOWLEDGE_GRAPH_MAX_DEPTH=3
KNOWLEDGE_GRAPH_MAX_NODES=100
KNOWLEDGE_GRAPH_MAX_EDGES=200
KNOWLEDGE_GRAPH_MAX_PATHS=20
KNOWLEDGE_GRAPH_MIN_CONFIDENCE=0.0
KNOWLEDGE_GRAPH_SNAPSHOT_SCHEMA_VERSION=1

# ---------------------------------------------------------------------------
# Personal AI Shopping Agent (fixture profiles; no auth / payment / DB)
# ---------------------------------------------------------------------------
PERSONAL_AGENT_ENABLED=true
PERSONAL_AGENT_DEFAULT_PROFILE_ID=profile-budget-student

# ---------------------------------------------------------------------------
# User Platform — demo/in-memory accounts (no OAuth / MFA / email delivery)
# ---------------------------------------------------------------------------
USER_PLATFORM_ENABLED=true

# ---------------------------------------------------------------------------
# Marketplace Data Synchronization (Sprint 18)
# Fixture / imported / simulated-live connectors only — no real marketplace HTTP
# ---------------------------------------------------------------------------
MARKETPLACE_DATA_ENABLED=true
MARKETPLACE_DATA_REQUIRE_AUTH=true

# ---------------------------------------------------------------------------
# Watchlists, Alert Rules, Notification Center & Dashboard (Sprint 19)
# Mock/simulated notifications only — no real email/SMS/push delivery.
# ---------------------------------------------------------------------------
WATCHLISTS_ALERTS_ENABLED=true
WATCHLISTS_REQUIRE_AUTH=true

# ---------------------------------------------------------------------------
# Affiliate Revenue Engine (Sprint 20) — demo/placeholder merchants only
# ---------------------------------------------------------------------------
AFFILIATE_ENABLED=true

# ---------------------------------------------------------------------------
# Merchant Platform (Sprint 21) — demo merchants only
# ---------------------------------------------------------------------------
MERCHANT_PLATFORM_ENABLED=true
MERCHANT_PLATFORM_REQUIRE_AUTH=true

# ---------------------------------------------------------------------------
# Launch Readiness & Production Preparation (Sprint 22)
# Demo/in-memory safe — no real cloud, payments, or production secrets.
# ---------------------------------------------------------------------------
LAUNCH_READINESS_ENABLED=true
LAUNCH_STRICT_STARTUP=false
RATE_LIMITING_ENABLED=true
SECURITY_HEADERS_ENABLED=true
STRUCTURED_LOGGING_ENABLED=true
DEMO_LAUNCHER_ENABLED=true
PERFORMANCE_CACHE_ENABLED=true
PERFORMANCE_CACHE_TTL_SECONDS=30
OPENAPI_PUBLIC_DOCS=false

RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTRATION_PER_MINUTE=5
RATE_LIMIT_AFFILIATE_PER_MINUTE=60
RATE_LIMIT_MERCHANT_PER_MINUTE=60
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_RECOMMENDATIONS_PER_MINUTE=60

SECURITY_HSTS_MAX_AGE=31536000
SECURITY_FRAME_OPTIONS=DENY
SECURITY_REFERRER_POLICY=strict-origin-when-cross-origin
SECURITY_PERMISSIONS_POLICY=camera=(), microphone=(), geolocation=(), payment=()
# SECURITY_CSP uses a safe default in code; override only if you know you need to.
