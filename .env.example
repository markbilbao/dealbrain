# Application
APP_NAME=DealBrain
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://dealbrain:dealbrain@localhost:5432/dealbrain
DATABASE_ECHO=false

# Canonical registry: memory (demo) or sqlalchemy (Postgres)
CANONICAL_REGISTRY_BACKEND=memory

# Price history: memory (demo) or sqlalchemy (Postgres)
PRICE_HISTORY_BACKEND=memory
PRICE_TREND_THRESHOLD_PERCENT=2.0
# Seed development-only iPhone mock history on /price-history/search (ignored in production)
PRICE_HISTORY_SEED_DEMO_MOCK=true

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------------------------------------------------------------------------
# AI Review Summary — multi-model providers (DISABLED by default)
# ---------------------------------------------------------------------------
# Adding API keys alone does NOT enable expensive modes or live HTTP.
# AI_REVIEW_ENABLED must be true AND AI_REVIEW_LIVE_HTTP must be true for
# real provider calls. Keep keys server-side only — never expose to clients.
AI_REVIEW_ENABLED=false
AI_REVIEW_MODE=economy
AI_REVIEW_ALLOW_CLIENT_MODE=true
AI_PRIMARY_PROVIDER=openai
AI_SECONDARY_PROVIDER=anthropic
AI_FALLBACK_ORDER=openai,anthropic,gemini,deterministic
AI_REVIEW_LIVE_HTTP=false

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

AI_PROVIDER_TIMEOUT_SECONDS=20
AI_MAX_REVIEW_INPUT=40
AI_MAX_ESTIMATED_COST_PER_REQUEST=0.05
