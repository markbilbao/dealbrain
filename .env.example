# Application
APP_NAME=DealBrain
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://dealbrain:dealbrain@localhost:5432/dealbrain
DATABASE_ECHO=false

# Canonical registry: memory (demo) or sqlalchemy (Postgres)
CANONICAL_REGISTRY_BACKEND=memory

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
