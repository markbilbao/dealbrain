# Example production inputs — SAFE TO COMMIT (no secrets).
# Copy to terraform.tfvars locally. Do NOT set any database password:
# RDS master credentials are AWS-managed (manage_master_user_password).
#
#   cp terraform.tfvars.example terraform.tfvars
#
# Fail-safe defaults: private RDS, deletion protection, backups ≥30d, Multi-AZ.

aws_region = "us-east-1"

vpc_cidr             = "10.20.0.0/16"
public_subnet_cidrs  = ["10.20.0.0/24", "10.20.1.0/24"]
private_subnet_cidrs = ["10.20.10.0/24", "10.20.11.0/24"]

enable_nat_gateway = true
single_nat_gateway = false

instance_type      = "t3.medium"
rds_instance_class = "db.t4g.medium"
db_name            = "dealbrain"
db_username        = "dealbrain"

backup_retention_days = 30
deletion_protection   = true
multi_az              = true
skip_final_snapshot   = false

# Set to a real ACM ARN before public traffic (never commit live ARNs if treated as sensitive).
alb_certificate_arn = "arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/REPLACE_ME"

domain_name     = "api.dealbrain.example"
image_reference = "ghcr.io/EXAMPLE_ORG/dealbrain@sha256:REPLACE_ME"

# Prefer restricting to known corporate / edge CIDRs when known.
allowed_ingress_cidrs = ["0.0.0.0/0"]

log_retention_days = 30

tags = {
  CostCenter = "dealbrain-production"
}
