# Example production inputs — SAFE TO COMMIT (no secrets).
# Copy to terraform.tfvars locally. Do NOT set any database password:
# RDS master credentials are AWS-managed (manage_master_user_password).
# Do NOT put GHCR tokens or AWS access keys here.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# Fail-safe defaults: private RDS, deletion protection, backups ≥30d, Multi-AZ.
# Apply account root first; then set github_oidc_provider_arn from its output.
# Do NOT terraform apply from CI or a deploy workflow.

aws_region = "us-east-1"

# OIDC trust inputs (mandatory; no wildcards).
# Production uses GitHub's immutable OIDC sub (use_default):
#   repo:markbilbao@309556720/dealbrain@1314423275:environment:production
# repository claim remains markbilbao/dealbrain.
github_repository_owner    = "markbilbao"
github_repository_name     = "dealbrain"
github_repository_owner_id = "309556720"
github_repository_id       = "1314423275"
github_oidc_provider_arn   = "arn:aws:iam::REPLACE_ACCOUNT_ID:oidc-provider/token.actions.githubusercontent.com"

vpc_cidr             = "10.20.0.0/16"
public_subnet_cidrs  = ["10.20.0.0/24", "10.20.1.0/24"]
private_subnet_cidrs = ["10.20.10.0/24", "10.20.11.0/24"]

enable_nat_gateway = true
single_nat_gateway = false

instance_type      = "t3.medium"
rds_instance_class = "db.t4g.medium"
db_name            = "dealbrain"
db_username        = "dealbrain"

backup_retention_days = 30
deletion_protection   = true
multi_az              = true
skip_final_snapshot   = false

# Set to a real ACM ARN before public traffic (never commit live ARNs if treated as sensitive).
# Empty keeps HTTP-only bootstrap; DNS cutover remains owner-controlled and is not this apply.
alb_certificate_arn = ""

domain_name     = "piqsavi.com"
image_reference = "ghcr.io/markbilbao/dealbrain@sha256:8140f6588bff07877885b6774767929c6561cfb6220c63ee4c2322931ebfbeaa"

# Prefer restricting to known corporate / edge CIDRs when known.
allowed_ingress_cidrs = ["0.0.0.0/0"]

log_retention_days = 30

tags = {
  CostCenter = "dealbrain-production"
}
