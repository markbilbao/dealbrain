# Example staging inputs — SAFE TO COMMIT (no secrets).
# Copy to terraform.tfvars locally. Do NOT set any database password:
# RDS master credentials are AWS-managed (manage_master_user_password).
# Do NOT put GHCR tokens or AWS access keys here.
#
#   cp terraform.tfvars.example terraform.tfvars
#
# Apply account root first; then set github_oidc_provider_arn from its output.

aws_region = "us-east-1"

# Sprint 25b.2 — OIDC trust inputs (mandatory; no wildcards).
github_repository_owner  = "markbilbao"
github_repository_name   = "dealbrain"
github_oidc_provider_arn = "arn:aws:iam::REPLACE_ACCOUNT_ID:oidc-provider/token.actions.githubusercontent.com"

vpc_cidr             = "10.10.0.0/16"
public_subnet_cidrs  = ["10.10.0.0/24", "10.10.1.0/24"]
private_subnet_cidrs = ["10.10.10.0/24", "10.10.11.0/24"]

enable_nat_gateway = true
single_nat_gateway = true

instance_type      = "t3.small"
rds_instance_class = "db.t4g.small"
db_name            = "dealbrain"
db_username        = "dealbrain"

backup_retention_days = 7
deletion_protection   = false
multi_az              = false
skip_final_snapshot   = true

# Leave empty until ACM cert exists (Sprint 25b+ DNS/TLS).
alb_certificate_arn = ""

domain_name     = "staging.dealbrain.example"
image_reference = "ghcr.io/EXAMPLE_ORG/dealbrain:sha-REPLACE_ME"

allowed_ingress_cidrs = ["0.0.0.0/0"]

log_retention_days = 14

tags = {
  CostCenter = "dealbrain-staging"
}
