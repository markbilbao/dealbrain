# Ignore local Terraform artifacts and secret-bearing var files
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Local var files may contain account-specific data; examples remain tracked
terraform.tfvars
*.auto.tfvars
!*.tfvars.example
